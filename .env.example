# ==========================================
# TradBotGems Configuration - Environment Variables
# ==========================================

# Telegram Bot Configuration (Required for notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# CoinGlass API (Optional: For futures, OI, funding rate, liquidation data)
COINGLASS_API_KEY=your_coinglass_api_key_here

# Blockchain Explorers (Optional: For on-chain analysis)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=

# Bot Filter Thresholds
MIN_MARKET_CAP_USD=20000
MAX_MARKET_CAP_USD=10000000
HIGH_VOLUME_THRESHOLD_USD=500000

# Timing Configuration (in seconds)
COLLECTION_INTERVAL_SECONDS=600
SLEEP_BETWEEN_TOKEN_REQUESTS_SECONDS=20
SLEEP_BETWEEN_PAGE_REQUESTS_SECONDS=22

# Cache Configuration
CACHE_FILE_NAME=coingecko_token_cache.json
CACHE_EXPIRY_HOURS=6
LOG_LEVEL=INFO
